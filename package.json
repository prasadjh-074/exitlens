{
  "name": "exitlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension",
    "demo-site"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w extension && npm run build -w demo-site",
    "demo": "node scripts/serve-demo.mjs",
    "dev": "npm run dev -w demo-site",
    "test": "vitest run tests/core.test.ts tests/worker.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "node tests/journey.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.65.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "eslint": "9.37.0",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
